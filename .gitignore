# ============================================================
# 统一 CG 演出回放库（Unified CG Replay Library）.gitignore
#
# 提交策略（三条铁律）：
#   1. 只提交：源码 / 文档 / schema / 小型分析产物 / <1MB 脱敏测试样本
#   2. 绝不提交：游戏资产（.ucgpkg 内的内容寻址资源）、库数据库、
#      缩略图、待删区文件、用户导出物 —— 体积巨大且含版权资源
#   3. 绝不提交：本机配置（含本机路径）、构建产物、日志临时文件
#
# 建议：库目录（packages/、library.db、thumbs/…）配置在仓库之外，
#       本文件是"万一指到仓库内"的安全网。
# 注意：Cargo.lock 对二进制/Tauri 项目【应提交】，勿加入本文件。
# ============================================================

# ------------------------------------------------------------
# 1. 库数据（核心：体积巨大 + 版权资产，绝不入库）
# ------------------------------------------------------------
# 包：一个游戏一个 .ucgpkg 目录（内含 assets/ 内容寻址资源 + IR/refs/scripts/manifest）
*.ucgpkg/
*.ucgpkg
# SQLite 中心库（仅索引；删除后可由各包重建，无需入库）
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
# 缩略图（WebP 派生物，后台任务可随时重建）
thumbs/
# 待删区（3 天保留期；里面是真实的待删文件）
trash/
pending-delete/
待删区/
# 冷归档：上传暂存区与生成的上传清单（可由资产重新生成）
cold-staging/
upload-lists/
*_待上传清单.*
# 若把库配置在仓库内（不推荐），整库目录一并忽略
library/

# ------------------------------------------------------------
# 2. 用户导出物（回放器导出的视频 / GIF / 静帧）
# ------------------------------------------------------------
exports/
export/

# ------------------------------------------------------------
# 3. 运行期生成 / 日志 / 临时 / 备份
# ------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.temp
*.bak
*.old
*~

# ------------------------------------------------------------
# 4. 本机配置（含本机路径 / 口令提示，绝不入库）
# ------------------------------------------------------------
*.local.json
*.local.toml
*.local.yaml
*.local.yml
settings.local.*
config.local.*
.env
.env.*
!.env.example

# ------------------------------------------------------------
# 5. Rust / Cargo（core 与 Tauri 壳）
# ------------------------------------------------------------
target/
debug/
*.pdb
*.so
*.dylib
# 例外：源码里的预编译二进制（如随附的 ffmpeg sidecar）如需入库，
# 用 !path/to/binary 显式放行；默认不放行。

# ------------------------------------------------------------
# 6. Node / 前端（Tauri Web 前端）
# ------------------------------------------------------------
node_modules/
dist/
.vite/
.parcel-cache/
coverage/
.nyc_output/
.eslintcache
.stylelintcache
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ------------------------------------------------------------
# 7. Tauri 生成物
# ------------------------------------------------------------
src-tauri/gen/schemas/
src-tauri/target/

# ------------------------------------------------------------
# 8. Python 工具（m0/ 与 tools/ 下的分析脚本）
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ------------------------------------------------------------
# 9. 大型测试样本（仅允许 <1MB 脱敏样本入库）
# ------------------------------------------------------------
fixtures/large/
test-data/real/
test-data/large/

# ------------------------------------------------------------
# 10. 操作系统 / 编辑器
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
# WorkBuddy 本地记忆（个人数据，不公开）
.workbuddy/
